name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - name: Install uv
        uses: astral-sh/setup-uv@v10.0.0

      - name: Cache uv
        uses: actions/cache@v6
        with:
          path: ~/.cache/uv
          key: {% raw %}${{ runner.os }}{% endraw %}-uv-{% raw %}${{ hashFiles('uv.lock') }}{% endraw %}
          restore-keys: |
            {% raw %}${{ runner.os }}{% endraw %}-uv-

      - name: Set up Python {{ python_version }}
        run: uv python install '{{ python_version }}'

      - name: Install dependencies
        run: uv sync --frozen

      - name: Run ruff check
        run: uv run ruff check .

      - name: Run ruff format check
        run: uv run ruff format --check .

      - name: Run ty
        run: uv run ty check 'src/{{ module_name | default(project_slug) }}'

{% if project_type == 'package' or include_pytest %}
  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: [{% if python_version == "3.11" %}"3.11", "3.12", "3.13", "3.14"{% elif python_version == "3.12" %}"3.12", "3.13", "3.14"{% elif python_version == "3.13" %}"3.13", "3.14"{% else %}"3.14"{% endif %}]
    steps:
      - uses: actions/checkout@v7

      - name: Install uv
        uses: astral-sh/setup-uv@v10.0.0

      - name: Cache uv
        uses: actions/cache@v6
        with:
          path: ~/.cache/uv
          key: {% raw %}${{ runner.os }}{% endraw %}-uv-{% raw %}${{ hashFiles('uv.lock') }}{% endraw %}
          restore-keys: |
            {% raw %}${{ runner.os }}{% endraw %}-uv-

      - name: Set up Python {% raw %}${{ matrix.python-version }}{% endraw %}
        run: uv python install {% raw %}${{ matrix.python-version }}{% endraw %}

      - name: Install dependencies
        run: uv sync --frozen

      - name: Run tests
        run: uv run pytest --cov='src/{{ module_name | default(project_slug) }}' --cov-report=xml --cov-report=term

      - name: Upload coverage
        uses: codecov/codecov-action@v7
        if: matrix.python-version == '{{ python_version }}'
        with:
          files: ./coverage.xml
{% endif %}
